---
/**
 * 스킬 찍는 순서 한 덩어리 — 능력마다 한 줄, 찍은 단계 자리에 표시 (게임 빌드 화면처럼, 2026-10-14 사용자 요청).
 * 처음 = 해금(보라 마름모), 이후 = 강화(그 강화에 드는 포인트 1 · 2 · 5). 모양은 global.css .skill-track.
 * SkillOrder(빌드 · 상위권 통계) · SkillMaxOrder(선마) 가 같이 쓰고, 빌드 페이지 창(scripts/builds.ts)도 같은 이름으로 그린다.
 * order 는 이미 정리된(능력마다 4번까지, id 가 모두 맞는) 순서여야 한다.
 */
import type { Ability } from '../data';
import { useTranslations, type Locale } from '../i18n';
import { gameImage } from '../lib/images';

interface Props {
  lang: Locale;
  abilities: Ability[];
  order: number[];
  /** 이 단계부터는 실제 데이터가 아니라 예상 (선마 — 20포인트 뒤를 같은 순서로 채운 부분). 흐리게 */
  predictedFrom?: number;
}
const { lang, abilities, order, predictedFrom = Infinity } = Astro.props;
const t = useTranslations(lang);
const bySlot = [...abilities].sort((a, b) => a.slot - b.slot);
const icons = await Promise.all(bySlot.map((a) => gameImage(a.image, 72, 72)));
/** 단계마다 그 능력의 몇 번째 찍기인지 — 0 = 해금, 1–3 = 강화 */
const seen = new Map<number, number>();
const nth = order.map((id) => {
  const n = seen.get(id) ?? 0;
  seen.set(id, n + 1);
  return n;
});
const COST = [0, 1, 2, 5];
---

<div class="skill-track" style={`--steps:${order.length}`} role="img" aria-label={t.heroes.skillOrderTitle}>
  {
    bySlot.map((a, r) => (
      <div class="st-row">
        <span class="st-icon" title={a.name}>
          {icons[r] ? <img src={icons[r]} alt={a.name} width="20" height="20" loading="lazy" /> : a.slot}
        </span>
        <span class="st-line">
          {order.map((id, i) =>
            id !== a.id ? null : nth[i] === 0 ? (
              <span
                class:list={['st-mark st-unlock', i >= predictedFrom && 'st-pred']}
                style={`grid-column:${i + 1}`}
                title={`${i + 1} · ${a.name} ${t.heroes.unlock}${i >= predictedFrom ? ` · ${t.heroes.predicted}` : ''}`}
              />
            ) : (
              <span
                class:list={['st-mark', i >= predictedFrom && 'st-pred']}
                style={`grid-column:${i + 1}`}
                title={`${i + 1} · ${a.name} ${t.heroes.upgrade} ${nth[i]}${i >= predictedFrom ? ` · ${t.heroes.predicted}` : ''}`}
              >
                {COST[nth[i]]}
              </span>
            ),
          )}
        </span>
      </div>
    ))
  }
</div>
