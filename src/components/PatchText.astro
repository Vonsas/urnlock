---
/** 패치노트 한 줄 — 번역된 줄은 번역·원문 두 벌을 넣고, PatchNoteView 의 data-show-orig 로 하나만 보인다 */
import type { PatchLine } from '../data';

interface Props {
  line: PatchLine;
}
const { line } = Astro.props;
---

{
  line.orig ? (
    <>
      <span class="patch-tr">{line.text}</span>
      <span class="patch-orig" lang="en">{line.orig}</span>
    </>
  ) : (
    line.text
  )
}
