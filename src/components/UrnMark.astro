---
/**
 * Urnlock 심볼 — 데드락 소울 항아리(둥근 뚜껑 · 목 띠 · 좁아지는 몸통 · 위아래 띠 홈) 몸통에 열쇠 구멍 (2026-10-03, 사용자 선택 U2).
 * 게임 그림을 쓰지 않고 실루엣만 참고해 새로 그렸다. 색은 currentColor (기본 강조색은 바깥에서 text-brass-400 등으로).
 * public/favicon.svg 도 같은 모양.
 */
interface Props {
  class?: string;
}
import { URN_PATH } from '../lib/urn-path';

const { class: className } = Astro.props;
---

<svg viewBox="0 0 100 140" fill="currentColor" aria-hidden="true" class={className}>
  <path fill-rule="evenodd" d={URN_PATH}></path>
</svg>
