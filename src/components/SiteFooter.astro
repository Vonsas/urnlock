---
import Wordmark from './Wordmark.astro';
import { allDictionaries, localePath, LOCALE_META, useTranslations, type Locale } from '../i18n';
import { getDataSource } from '../data';
import { MENU_SECTIONS } from '../lib/sections';
import { THEMES } from '../lib/themes';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const source = await getDataSource();
// 비공식 고지는 현재 언어를 먼저, 나머지 두 언어를 뒤에 함께 싣는다
const notices = allDictionaries().sort(([a], [b]) => Number(b === lang) - Number(a === lang));
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-page gap-x-10 gap-y-8 px-4 py-8 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto]">
    <div>
      {/* 이름은 aria-label 대신 숨긴 글자로 — 로고가 그림이라 검색엔진이 사이트 이름을 글자로 못 읽었다 (2026-11-03) */}
      <p><Wordmark class="text-[1.375rem] text-paper-50" /><span class="sr-only">{t.site.name}</span></p>
      <ul class="mt-3 space-y-1.5">
        {
          notices.map(([code, d], i) => (
            <li lang={LOCALE_META[code].htmlLang} class:list={[i === 0 ? 'text-sm text-paper-200' : 'text-xs text-paper-400']}>
              {d.footer.disclaimer} {d.footer.trademark}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="grid grid-cols-2 gap-x-10 gap-y-1 text-sm md:text-right">
      <ul class="space-y-1">
        {
          MENU_SECTIONS.map((s) => (
            <li>
              <a href={localePath(lang, s.key)} class="text-paper-400 hover:text-paper-50">
                {s.key === 'players' ? t.nav.ranking : t.nav[s.key]}
              </a>
            </li>
          ))
        }
      </ul>
      <dl class="space-y-1 text-xs text-paper-400">
        <dt class="label text-paper-400">{t.footer.dataSource}</dt>
        <dd>{source === 'mock' ? t.footer.dataSourceMock : 'deadlock-api.com'}</dd>
        <dt class="label pt-2 text-paper-400">&copy; {new Date().getFullYear()} {t.site.name}</dt>
        <dd>{t.footer.nonCommercial}</dd>
        {/* 색 테마 — 누르면 바로 바뀌고 이 브라우저에 기억 (scripts/theme.ts). 지금 테마는 스크립트가 aria-pressed 로 표시.
            휴대폰은 칸이 좁아 여섯 개가 5 + 1 로 갈려서 3 × 2 로 */}
        <dt class="label pt-2 text-paper-400">{t.footer.theme}</dt>
        <dd class="pt-1">
          <div class="grid w-max grid-cols-3 gap-1.5 sm:flex sm:w-auto sm:flex-wrap md:justify-end" role="group" aria-label={t.footer.theme}>
          {
            THEMES.map((th) => (
              <button
                type="button"
                data-theme-pick={th}
                data-swatch={th}
                aria-pressed="false"
                aria-label={t.footer.themes[th]}
                title={t.footer.themes[th]}
                class="theme-swatch size-6 shrink-0 rounded-xs ring-1 ring-line-strong transition-[box-shadow] duration-150 hover:ring-paper-400 aria-pressed:ring-2 aria-pressed:ring-paper-50"
              />
            ))
          }
          </div>
        </dd>
      </dl>
    </div>
  </div>
</footer>

<script>
  import '../scripts/theme.ts';
</script>
