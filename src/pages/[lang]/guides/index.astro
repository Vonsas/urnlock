---
/** 가이드 목록 (2026-10-06) — 영웅 고르기 · 추천순/최신순 · 카드. 스팀 인증한 유저가 쓴 가이드 (scripts/guides.ts) */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import { LOCALES, localePath, toLocale, useTranslations } from '../../../i18n';
import { guidesPageConfig } from '../../../lib/guides-page';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const t = useTranslations(lang);
const configJson = await guidesPageConfig(lang, 'list');
---

<BaseLayout lang={lang} title={t.nav.guides} description={t.home.sectionDesc.guides}>
  <PageHead title={t.nav.guides}>
    <a
      href={localePath(lang, 'guides/write')}
      data-guides-write-link
      class="inline-flex items-center gap-1.5 rounded-md bg-brass-400 px-4 py-2 text-sm font-bold text-ink-950 transition-colors duration-150 hover:bg-brass-200"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v10M3 8h10"></path></svg>
      {t.guides.write}
    </a>
  </PageHead>
  <div data-guides-view></div>
  <script type="application/json" id="guides-config" set:html={configJson} />
</BaseLayout>

<script>
  import '../../../scripts/guides.ts';
</script>
