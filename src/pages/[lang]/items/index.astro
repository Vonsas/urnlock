---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import ShopItem, { type ShopLookupEntry } from '../../../components/ShopItem.astro';
import { gameImage } from '../../../lib/images';
import { LOCALES, toLocale, useTranslations } from '../../../i18n';
import { getItems, ITEM_CATEGORIES, ITEM_TIERS, tierCost } from '../../../data';
import { fill, formatNumber } from '../../../lib/format';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const t = useTranslations(lang);
const [items, enItems] = await Promise.all([getItems(lang), getItems('en')]);
const enName = new Map(enItems.map((i) => [i.slug, i.name]));
// 카드·툴팁·하위 아이템 칩이 같은 그림 파일(168px)을 쓰도록 한 번만 만든다
const srcs = await Promise.all(items.map((i) => gameImage(i.image, 168, 168)));
const lookup = new Map<string, ShopLookupEntry>(items.map((i, n) => [i.slug, { name: i.name, src: srcs[n], category: i.category }]));

// 게임 상점: 탭은 분류 원색, 판은 분류별 탁한 색, 4티어 칸만 어두운 색 (Tailwind 가 찾도록 정적 문자열)
const tabBg = { weapon: 'bg-weapon', vitality: 'bg-vitality', spirit: 'bg-spirit' } as const;
const panelBg = { weapon: 'bg-shop-weapon', vitality: 'bg-shop-vitality', spirit: 'bg-shop-spirit' } as const;
const deepBg = { weapon: 'bg-shop-weapon-deep', vitality: 'bg-shop-vitality-deep', spirit: 'bg-shop-spirit-deep' } as const;
import SoulIcon from '../../../components/SoulIcon.astro';
---

<BaseLayout lang={lang} seoTitle={t.seo.items} title={t.items.title} description={t.items.lede}>
  <!-- 게임 상점처럼: 왼쪽 세로 분류 탭 + 분류색 판 안에 티어 2×2. 검색하는 동안에는 세 분류를 모두 보여준다 -->
  <div data-filter="items" data-item-tabs class="group">
    <!-- 제목 줄: 오른쪽 위에 액티브만 · 검색 -->
    <PageHead title={t.items.title}>
      <div class="flex w-full flex-wrap items-center gap-3 sm:w-auto">
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold whitespace-nowrap text-paper-200">
          <input type="checkbox" data-filter-flag="active" class="size-4 rounded-xs accent-brass-400" />
          {t.items.activeOnly}
        </label>
        <label class="sr-only" for="item-q">{t.items.searchPlaceholder}</label>
        <span class="relative min-w-0 flex-1 sm:flex-none">
          <svg aria-hidden="true" viewBox="0 0 16 16" class="pointer-events-none absolute top-1/2 left-3 size-3.5 -translate-y-1/2 text-paper-500" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.75"></circle><path d="m10.5 10.5 3.5 3.5"></path></svg>
          <input id="item-q" type="search" data-filter-text placeholder={t.items.searchPlaceholder} class="field field-icon w-full sm:w-72" />
        </span>
      </div>
    </PageHead>

    <div class="flex flex-col lg:flex-row">
      <!-- 분류 탭 -->
      <div
        role="tablist"
        aria-label={t.items.categoryFilter}
        aria-orientation="vertical"
        class="flex gap-1 lg:w-16 lg:flex-none lg:flex-col lg:gap-1.5 lg:pt-3"
      >
        {
          ITEM_CATEGORIES.map((c, i) => (
            <a
              role="tab"
              id={`tab-${c}`}
              href={`#cat-${c}`}
              data-tab={c}
              aria-controls={`cat-${c}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              title={t.items.categories[c]}
              class:list={[
                'flex h-11 flex-1 items-center justify-center gap-2 rounded-t-md text-shop-ink opacity-45 transition-opacity duration-150 hover:opacity-80 aria-selected:opacity-100',
                'lg:h-16 lg:w-16 lg:flex-none lg:rounded-l-md lg:rounded-tr-none',
                'group-data-searching:opacity-45',
                tabBg[c],
              ]}
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 lg:size-8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                {c === 'weapon' && (
                  <>
                    <circle cx="12" cy="12" r="7" />
                    <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none" />
                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4" />
                  </>
                )}
                {c === 'vitality' && <path d="M12 4v16M4 12h16" stroke-width="4.2" stroke-linecap="butt" />}
                {c === 'spirit' && (
                  <>
                    <circle cx="12" cy="12" r="9" stroke-width="1.6" />
                    <path d="M12 3.5 16.9 18.6 4 9.3h16L7.1 18.6Z" stroke-width="1.6" />
                  </>
                )}
              </svg>
              <span class="text-sm font-extrabold lg:sr-only">{t.items.categories[c]}</span>
            </a>
          ))
        }
      </div>

      <!-- 분류별 상점 판 -->
      <div class="min-w-0 flex-1">
        {
          ITEM_CATEGORIES.map((c) => {
            const inCat = items.filter((i) => i.category === c);
            return (
              <section
                id={`cat-${c}`}
                role="tabpanel"
                aria-labelledby={`tab-${c}`}
                data-filter-group
                data-tab-panel
                class:list={['scroll-mt-20 rounded-b-lg p-2 sm:p-3 lg:rounded-lg group-data-searching:mb-3 group-data-searching:rounded-lg', panelBg[c]]}
              >
                <h2 class="flex items-baseline gap-2 px-1 pt-1 pb-2.5 text-xl font-extrabold tracking-tight text-shop-ink">
                  {t.items.categories[c]}
                  <span class="text-sm font-semibold text-shop-ink/55 tabular-nums">{inCat.length}</span>
                </h2>
                <div class="grid gap-2 sm:gap-3 lg:grid-cols-2">
                  {ITEM_TIERS.map((tier) => {
                    const tierItems = inCat.filter((i) => i.tier === tier);
                    if (tierItems.length === 0) return null;
                    const dark = tier === 4;
                    return (
                      <section
                        data-filter-group
                        aria-label={fill(t.items.tier, { n: tier })}
                        class:list={['rounded-md p-2 pt-2.5 ring-1 sm:p-2.5 sm:pt-3', dark ? [deepBg[c], 'ring-black/50'] : 'bg-white/22 ring-black/15']}
                      >
                        <p class="mb-2 flex items-center gap-2">
                          <span class="price-tag">
                            <SoulIcon />
                            {formatNumber(lang, tierCost(tier))}
                            <span class="sr-only">{t.common.souls}</span>
                          </span>
                          <span class:list={['text-xs font-extrabold tracking-wider uppercase', dark ? 'text-paper-200' : 'text-shop-ink/70']}>
                            {fill(t.items.tier, { n: tier })}
                          </span>
                        </p>
                        <ul class="grid grid-cols-[repeat(auto-fill,minmax(4.5rem,1fr))] gap-1.5">
                          {tierItems.map((i) => (
                            <ShopItem item={i} lang={lang} lookup={lookup} alt={enName.get(i.slug)} dark={dark} />
                          ))}
                        </ul>
                      </section>
                    );
                  })}
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
    {/* 그려지기 전에 첫 탭(또는 주소가 가리키는 분류)만 남긴다. JS 가 없으면 세 분류 모두 보인다 */}
    <script is:inline>
      (function () {
        var h = '';
        try { h = decodeURIComponent(location.hash.slice(1)); } catch (e) { /* 깨진 # 은 무시 */ }
        var el = h && document.getElementById(h);
        var panel = el && el.closest ? el.closest('[data-tab-panel]') : null;
        var open = panel ? panel.id : 'cat-weapon';
        document.querySelectorAll('[data-tab-panel]').forEach(function (p) {
          if (p.id !== open) p.setAttribute('data-tab-hidden', '');
        });
      })();
    </script>

    <p data-filter-empty hidden class="mt-8 text-center text-paper-400">{t.common.noResults}</p>
  </div>

  <!-- 아이템 상세 창 — 카드를 누르면 그 아이템의 <template> 내용을 옮겨 그린다 -->
  <dialog
    id="item-dialog"
    aria-label={t.items.title}
    class="m-auto w-[min(32rem,calc(100vw-1.5rem))] overflow-hidden rounded-lg border border-line-strong bg-ink-850 p-0 text-paper-50 shadow-[0_24px_64px_rgb(0_0_0/0.6)] backdrop:bg-black/65"
  >
    <!-- 끝까지 스크롤해도 뒤 페이지로 넘어가지 않게 (overscroll-contain) -->
    <div data-dialog-body class="max-h-[85dvh] overflow-y-auto overscroll-contain"></div>
    <button
      type="button"
      data-close-dialog
      aria-label={t.items.tip.close}
      class="absolute top-3 right-3 grid size-9 place-items-center rounded-sm text-paper-400 transition-colors duration-150 hover:bg-ink-800 hover:text-paper-50"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg>
    </button>
  </dialog>
</BaseLayout>

<script>
  import '../../../scripts/filters.ts';

  // 분류 탭 — 주소의 #cat-weapon 이나 아이템 slug(#extended-magazine)로 해당 분류를 연다
  const root = document.querySelector<HTMLElement>('[data-item-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-tab-panel]')];
    const search = root.querySelector<HTMLInputElement>('[data-filter-text]');
    let current = 'weapon';

    const render = () => {
      const searching = Boolean(search?.value.trim());
      root.toggleAttribute('data-searching', searching);
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === current;
        tab.setAttribute('aria-selected', String(on && !searching));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => p.toggleAttribute('data-tab-hidden', !searching && p.id !== `cat-${current}`));
    };
    const select = (c: string) => {
      current = c;
      if (search?.value) {
        search.value = '';
        search.dispatchEvent(new Event('input'));
      }
      render();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        select(tab.dataset.tab!);
        history.replaceState(null, '', `#cat-${tab.dataset.tab}`);
      });
      tab.addEventListener('keydown', (e) => {
        const forward = e.key === 'ArrowRight' || e.key === 'ArrowDown';
        if (!forward && e.key !== 'ArrowLeft' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const next = tabs[(i + (forward ? 1 : tabs.length - 1)) % tabs.length];
        select(next.dataset.tab!);
        next.focus();
        history.replaceState(null, '', `#cat-${next.dataset.tab}`);
      });
    });
    search?.addEventListener('input', render);

    // 주소의 # 가 가리키는 분류를 열고, 아이템 slug 면 그 타일로 스크롤 (헤더 검색 결과 링크)
    const openFromHash = () => {
      // 깨진 # (예 #%E0) 이면 decodeURIComponent 가 던져 아래 스크립트가 다 멈췄다
      let target = '';
      try {
        target = decodeURIComponent(location.hash.slice(1));
      } catch {
        /* 무시 */
      }
      const panel = target ? document.getElementById(target)?.closest<HTMLElement>('[data-tab-panel]') : null;
      if (panel) current = panel.id.replace('cat-', '');
      render();
      if (target && !target.startsWith('cat-') && document.getElementById(target)) {
        document.getElementById(target)?.scrollIntoView({ block: 'center' });
        openItem(target, false);
      }
    };

    // 상세 창 — 카드·하위/상위 아이템 칩(data-open-item)을 누르면 열고, 주소를 #아이템 으로 바꿔 공유할 수 있게 한다
    const dialog = document.getElementById('item-dialog') as HTMLDialogElement | null;
    const dialogBody = dialog?.querySelector<HTMLElement>('[data-dialog-body]');
    const openItem = (slug: string, updateHash = true) => {
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-item-detail="${CSS.escape(slug)}"]`);
      if (!dialog || !dialogBody || !tpl) return;
      dialogBody.replaceChildren(tpl.content.cloneNode(true));
      dialogBody.scrollTop = 0;
      if (!dialog.open) dialog.showModal();
      if (updateHash) history.replaceState(null, '', `#${slug}`);
    };
    document.addEventListener('click', (e) => {
      const opener = (e.target as Element).closest<HTMLElement>('[data-open-item]');
      if (!opener) return;
      e.preventDefault();
      openItem(opener.dataset.openItem!);
    });
    // 닫으면 주소를 분류(#cat-…)로 되돌린다. Esc 는 close 이벤트로, 단추·배경은 직접 처리한다
    const restoreHash = () => {
      if (!location.hash.startsWith('#cat-')) history.replaceState(null, '', `#cat-${current}`);
    };
    const closeDialog = () => {
      dialog?.close();
      restoreHash();
    };
    dialog?.querySelector('[data-close-dialog]')?.addEventListener('click', closeDialog);
    // 창 바깥(배경)을 누르면 닫는다
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });
    dialog?.addEventListener('close', restoreHash);
    window.addEventListener('hashchange', openFromHash);
    openFromHash();

    // 툴팁이 화면 오른쪽·아래로 넘치면 반대쪽에 띄운다
    const place = (host: HTMLElement) => {
      const tip = host.querySelector<HTMLElement>('.tip');
      if (!tip) return;
      tip.style.left = tip.style.right = tip.style.top = tip.style.bottom = '';
      const r = tip.getBoundingClientRect();
      if (r.right > window.innerWidth - 8) {
        tip.style.left = 'auto';
        tip.style.right = '0';
      }
      if (r.bottom > window.innerHeight - 8 && host.getBoundingClientRect().top > r.height + 16) {
        tip.style.top = 'auto';
        tip.style.bottom = 'calc(100% + 6px)';
      }
    };
    root.querySelectorAll<HTMLElement>('[data-tip-host]').forEach((host) => {
      host.addEventListener('mouseenter', () => place(host));
      host.addEventListener('focusin', () => place(host));
    });

    // 개발용: ?tip=아이템-slug 로 그 아이템의 툴팁을 열어 둔다 (헤드리스 캡처 확인용)
    if (import.meta.env.DEV) {
      const slug = new URLSearchParams(location.search).get('tip');
      const host = slug ? document.getElementById(slug) : null;
      if (host) {
        host.focus({ preventScroll: true });
        place(host);
      }
    }
  }
</script>
