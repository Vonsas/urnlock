---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CityScene from '../components/CityScene.astro';
import { LOCALES, LOCALE_META, localePath, stripLocale, useTranslations, type Locale } from '../i18n';
import { getDataSource } from '../data';
import { gameSvg } from '../lib/images';
import { SOUL_ICON_URL } from '../lib/icons';

interface Props {
  lang: Locale;
  /** 페이지 제목. 없으면 사이트 이름과 부제만 */
  title?: string;
  /** 검색 결과·링크 미리보기용 제목 (예: '데드락 티어'). 없으면 title */
  seoTitle?: string;
  description?: string;
  /** 헤더 검색창을 숨긴다 — 본문에 큰 검색창이 있는 첫 페이지 */
  hideSearch?: boolean;
  /** 검색 엔진에 올리지 않는다 ('준비 중' 페이지 등) */
  noindex?: boolean;
}
const { lang, title, seoTitle, description, hideSearch = false, noindex = false } = Astro.props;
const t = useTranslations(lang);
const source = await getDataSource();
// 소울 아이콘 모양 — 아이템 페이지에 수백 개라 주소를 칸마다 쓰지 않고 페이지에 한 번 (SoulIcon · global.css .soul-icon, 2026-10-14 최적화)
const soulMask = await gameSvg(SOUL_ICON_URL);

const pageTitle = seoTitle ?? title;
const fullTitle = pageTitle ? `${pageTitle} · ${t.site.name}` : `${t.site.name} — ${t.site.subtitle}`;
const rest = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={LOCALE_META[lang].htmlLang}>
  <head>
    {soulMask && <Fragment set:html={`<style>:root{--soul-mask:url(${soulMask})}</style>`} />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t.site.description} />
    <meta name="theme-color" content="#0b1a20" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* 구글 검색 결과 아이콘은 비트맵(48px 배수)을 쓴다 — tools/build-favicons.mjs */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* 검색 등록 소유 확인 — 네이버 서치어드바이저 (구글 서치 콘솔은 가비아 DNS 의 TXT 레코드로 확인) */}
    <meta name="naver-site-verification" content="5b5899804ef40924b0c2f0dfbbf651bdae55f129" />
    {/* 링크 미리보기 (디시·디스코드·카톡) — 카드는 public/og/{lang}.png, tools/build-og.mjs 로 다시 만든다 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? t.site.description} />
    <meta property="og:locale" content={{ ko: 'ko_KR', en: 'en_US', zh: 'zh_CN' }[lang]} />
    <meta property="og:image" content={new URL(`/og/${lang}.png`, Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    {/* 방문자 통계 — Cloudflare Web Analytics (쿠키 없음, 배포 빌드에만). 2026-10-30 Vercel Web Analytics 에서 바꿈 —
        그쪽은 페이지뷰마다 스크립트 + 수집 요청이 Vercel 로 가서 CDN 요청 한도의 약 15% 를 썼다. 토큰은 공개 값 (CSP 는 vercel.json).
        noindex 페이지(관리자 · 준비 중)엔 싣지 않는다 — 관리자 비밀번호 칸과 다른 회사 스크립트를 한 페이지에 두지 않으려고 */}
    {import.meta.env.PROD && !noindex && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ed0a6a427f274fc4874472c35fc64144"}'></script>}
    {/* 검색 노출 (2026-10-05): 정식 주소 · 언어별 같은 페이지 · 언어를 모를 때(x-default)는 한국어. 사이트맵은 /sitemap.xml */}
    {noindex && <meta name="robots" content="noindex" />}
    {Astro.site && !noindex && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    {
      Astro.site && !noindex &&
        LOCALES.map((code) => (
          <link rel="alternate" hreflang={LOCALE_META[code].htmlLang} href={new URL(localePath(code, rest), Astro.site)} />
        ))
    }
    {Astro.site && !noindex && <link rel="alternate" hreflang="x-default" href={new URL(localePath('ko', rest), Astro.site)} />}

  </head>
  <body class="flex min-h-dvh flex-col">
    {
      // 첫 페이지 외: 밤 도시 장면을 화면 전체 배경으로 고정 (스크롤해도 그 자리). 2026-10-04 사용자 요청 — 평평한 면만 있으면 'AI 티',
      // 처음엔 위쪽 띠로 옅게 깔았다가 '전체적으로 보이게 + 박스는 더 검게'. 음수 z-index 라 헤더·내용 아래에 그려진다.
      !Astro.slots.has('hero') && (
        <div aria-hidden="true" class="page-backdrop pointer-events-none fixed inset-0 -z-10">
          <CityScene compact />
        </div>
      )
    }
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-10 focus:bg-brass-400 focus:px-3 focus:py-2 focus:text-ink-950"
    >
      {t.nav.skip}
    </a>
    {
      source === 'mock' && (
        <p class="bg-copper-400/10 px-4 py-1.5 text-center text-xs text-paper-400">
          <span class="mr-2 font-semibold text-copper-400">{t.site.mockTag}</span>
          {t.site.mockNotice}
        </p>
      )
    }
    <SiteHeader lang={lang} hideSearch={hideSearch} />
    <!-- 화면 폭 전체를 쓰는 머리 장면 (첫 페이지의 밤 도시) — main 의 최대 폭 밖 -->
    <slot name="hero" />
    {
      Astro.slots.has('hero') ? (
        <main id="main" class="mx-auto w-full max-w-page flex-1 px-4 pb-16 sm:px-6">
          <slot />
        </main>
      ) : (
        <main id="main" class="mx-auto w-full max-w-page flex-1 px-4 pb-16 sm:px-6">
          <slot />
        </main>
      )
    }
    <SiteFooter lang={lang} />
    <script>
      // 사이트 공용 툴팁 — title · data-tip 을 사이트 색 상자로
      import '../scripts/tooltip.ts';
    </script>
  </body>
</html>
